# Only Telegram bot token and your numeric Telegram user ID are needed for bot access.
BOT_TOKEN=123456789:replace_with_BotFather_token
ADMIN_TELEGRAM_IDS=123456789

# Render generates SESSION_SECRET automatically from render.yaml.
SESSION_SECRET=generate_a_long_random_secret_for_local_testing
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=replace_with_a_strong_password
COOKIE_SECURE=true
DATA_FILE=/var/data/users.json
